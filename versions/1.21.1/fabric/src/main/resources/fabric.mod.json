{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "MIT",
  "icon": "mcpj_logo.png",
  "contact": {
    "homepage": "https://github.com/MatWein/MCPJ",
    "sources": "https://github.com/MatWein/MCPJ",
    "issues": "https://github.com/MatWein/MCPJ/issues"
  },
  "environment": "*",
  "accessWidener": "mcpj.accesswidener",
  "entrypoints": {
    "main": ["de.mcpj.fabric.McpjFabric"],
    "client": ["de.mcpj.fabric.client.McpjFabricClient"],
    "fabric-gametest": ["de.mcpj.mc.gametest.McpjGameTestGenerator"]
  },
  "mixins": ["mcpj.mixins.json", "mcpj.fabric.mixins.json"],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*"
  }
}
